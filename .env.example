# Create a Resend account, verify your sending domain, then add these values in your hosting provider.
# Use true only for demos. Mock mode displays the success state but does not send an email.
CONTACT_FORM_MOCK=true

# Set CONTACT_FORM_MOCK=false before using live delivery.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL=Kids Palace Website <enquiries@your-domain.com>


